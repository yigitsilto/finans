# Zafir Sigorta Finans – cPanel (finans.sigortacimzafir.com) ortam dosyası
# Sunucuda zafir-finans/.env olarak kaydedin. Bu dosyaya gerçek parola yazıp git'e EKLEMEYİN.

APP_NAME="Zafir Sigorta Finans"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://finans.sigortacimzafir.com
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_MAINTENANCE_DRIVER=file

# Demo ortamıysa true: üstte "Demo ortamı" bandı + arama motorlarına kapalı
APP_DEMO=true

# HTTPS (cPanel AutoSSL) – linklerin https üretilmesi ve güvenli çerez
FORCE_HTTPS=true
# Yalnızca Cloudflare gibi bir proxy arkasındaysanız "*" yapın
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# cPanel > MySQL Veritabanları ekranında oluşturduğunuz bilgiler (sunucu MariaDB 10.11)
# (cPanel adların başına kullanıcı adınızı ekler, ör. kullanici_finans)
# PostgreSQL kullanılacaksa: DB_CONNECTION=pgsql, DB_PORT=5432
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@sigortacimzafir.com"
MAIL_FROM_NAME="${APP_NAME}"

FINANCE_LIQUIDITY_HORIZON_DAYS=30
FINANCE_LIQUIDITY_WARNING_PERCENT=80
FINANCE_FIXED_EXPENSE_WARNING_PERCENT=70
